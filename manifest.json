{
  "manifest_version": 3,
  "name": "itslearning Overzicht",
  "short_name": "Overzicht",
  "version": "0.6.0",
  "description": "Eén overzicht van huiswerk, toetsen en openstaande opdrachten over alle vakken in itslearning.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open itslearning-overzicht",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://*.itslearning.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
